# Bubble credentials are server-side only — set BUBBLE_API_KEY in server/.env
# VITE_BUBBLE_API_TOKEN and VITE_BUBBLE_API_BASE_URL no longer needed on the frontend

# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Configuration
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Backend API (for checkout). Production: https://acquiro-backend.vercel.app
VITE_API_URL=http://localhost:3001

# Scraper server (Railway)
VITE_SCRAPER_URL=https://acquiro-scraper-production.up.railway.app
VITE_SCRAPER_ADMIN_KEY=your_scraper_admin_key_here
