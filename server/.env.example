# Server Configuration
PORT=3001
# For local dev use http://localhost:5173. For Vercel set to https://acquirolabs.vercel.app
FRONTEND_URL=http://localhost:5173

# JWT — sign with a long random secret (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxx
# Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx

# ElevenLabs
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Scraper (Railway) — NEVER put these in the frontend .env
SCRAPER_URL=https://acquiro-scraper-production.up.railway.app
SCRAPER_ADMIN_KEY=your_scraper_admin_key_here
